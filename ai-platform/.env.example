COMPOSE_PROJECT_NAME=ups-platform

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=litellm

# ─── LiteLLM ──────────────────────────────────────────────────────────────────
# Genera con: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-change-me-master-key
LITELLM_SALT_KEY=change-me-salt-key

# ─── Panel de administración LiteLLM  http://<IP>:80/ui ──────────────────────
UI_USERNAME=admin
UI_PASSWORD=change-me-ui-password

# ─── Modelos ──────────────────────────────────────────────────────────────────
# Ruta absoluta en el host donde se almacenan los modelos descargados
MODELS_PATH=/data/models

# ─── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Token del túnel, generado en el dashboard de Cloudflare Zero Trust
# (Networks > Tunnels > Create a tunnel > Docker). Ver README para el proceso completo.
CLOUDFLARE_TUNNEL_TOKEN=change-me-tunnel-token
