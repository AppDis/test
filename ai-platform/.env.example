COMPOSE_PROJECT_NAME=ups-platform

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=litellm

# ─── LiteLLM ──────────────────────────────────────────────────────────────────
# Genera con: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-change-me-master-key
LITELLM_SALT_KEY=change-me-salt-key

# ─── Panel de administración LiteLLM (/ui) ───────────────────────────────────
UI_USERNAME=admin
UI_PASSWORD=change-me-ui-password

# ─── Dominio institucional ────────────────────────────────────────────────────
DOMAIN=ia.example.edu.ec

# ─── Modelos ──────────────────────────────────────────────────────────────────
# Ruta absoluta en el host donde se almacenan los modelos descargados
MODELS_PATH=/data/models
