COMPOSE_PROJECT_NAME=ups-local

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=litellm
POSTGRES_PASSWORD=local_password
POSTGRES_DB=litellm

# ─── LiteLLM ──────────────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=sk-local-dev-key
LITELLM_SALT_KEY=local-salt-key

# ─── Panel de administración LiteLLM (http://localhost:4000/ui) ──────────────
UI_USERNAME=admin
UI_PASSWORD=admin-local-password

# ─── Modelo Ollama ────────────────────────────────────────────────────────────
# llama3.2:3b ~ 2 GB descarga, corre en CPU en Mac Intel.
# Alternativas más pequeñas: qwen2.5:1.5b (~0.9 GB), phi3.5:mini (~2.2 GB)
OLLAMA_MODEL=llama3.2:3b
